    "### gpr_ISR Processing\n",
    "end_year = 2026\n",
    "end_month = 6\n",
    "country=\"ISR\"\n",
    "\n",
    "gpr_ISR = gpr_raw[ (gpr_raw['month'] >= f\"{start_year}-01-01\") & (gpr_raw['month'] < f\"{end_year}-{end_month}-01\") ] \\\n",
    "    .filter(like = f'GPRC_{country}') \\\n",
    "    .reset_index(drop = True) \n",
    "       \n",
    "\n",
    "assert gpr_ISR.isna().any(axis=0).values == False # nan values check\n",
    "assert gpr_ISR.eq(' ').sum().values == 0          # blank values check\n",
    "\n",
    "\n",
    "gpr_ISR\n",
    "\n"
   ]
