   "source": [
    "### olim Processing\n",
    "start_year = 1989\n",
    "\n",
    "olim_until_2023_df = olim_1989_2023_raw[ olim_1989_2023_raw[\"year\"] >= start_year ][\"olim\"] \\\n",
    "                        .reset_index(drop=True) # selecting start_year-2023 range\n",
    "\n",
    "olim_2024_df = olim_2024_raw.iloc[3, 4:].reset_index(drop=True)\n",
    "\n",
    "olim_2025_df = olim_2025_raw.iloc[3, 4:].reset_index(drop=True)\n",
    "\n",
    "olim_2026_df = olim_2026_raw.iloc[3, 4:].reset_index(drop=True)\n",
    "\n",
    "df_lst = [olim_until_2023_df, olim_2024_df, olim_2025_df, olim_2026_df]\n",
    "\n",
    "for df in df_lst :\n",
    "    assert df.isna().any(axis=0) == False, f\"NaN values in dataframe {df}\" # nan values check\n",
    "    assert df.eq(' ').sum() == 0,  f\"missing values in dataframe {df}\"     # blank values check\n",
    "\n",
    "olim = pd.concat(df_lst, axis=0) \\\n",
    "                    .reset_index(drop=True)\n",
    "\n",
    "olim"
   ]
  },
